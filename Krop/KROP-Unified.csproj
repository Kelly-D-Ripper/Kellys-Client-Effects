<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework><LangVersion>latest</LangVersion>
    <AssemblyName>KROP.UnifiedEffects</AssemblyName><RootNamespace>KropClientEffects</RootNamespace>
    <Version>0.1.3</Version><Deterministic>true</Deterministic><NuGetAudit>false</NuGetAudit>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems><RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources>
    <BepInExPath>$(NUCLEAR_OPTION_DIR)\BepInEx\core</BepInExPath>
  </PropertyGroup>
  <ItemGroup><Compile Include="src\**\*.cs" /></ItemGroup>
  <ItemGroup>
    <Reference Include="BepInEx" HintPath="$(BepInExPath)\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExPath)\0Harmony.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(NUCLEAR_OPTION_DIR)\NuclearOption_Data\Managed\Assembly-CSharp.dll" Private="false" />
    <Reference Include="Mirage" HintPath="$(NUCLEAR_OPTION_DIR)\NuclearOption_Data\Managed\Mirage.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(NUCLEAR_OPTION_DIR)\NuclearOption_Data\Managed\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(NUCLEAR_OPTION_DIR)\NuclearOption_Data\Managed\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.AudioModule" HintPath="$(NUCLEAR_OPTION_DIR)\NuclearOption_Data\Managed\UnityEngine.AudioModule.dll" Private="false" />
    <Reference Include="UnityEngine.ParticleSystemModule" HintPath="$(NUCLEAR_OPTION_DIR)\NuclearOption_Data\Managed\UnityEngine.ParticleSystemModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(NUCLEAR_OPTION_DIR)\NuclearOption_Data\Managed\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="UnityEngine.AssetBundleModule" HintPath="$(NUCLEAR_OPTION_DIR)\NuclearOption_Data\Managed\UnityEngine.AssetBundleModule.dll" Private="false" />
    <Reference Include="UnityEngine.ImageConversionModule" HintPath="$(NUCLEAR_OPTION_DIR)\NuclearOption_Data\Managed\UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(NUCLEAR_OPTION_DIR)\NuclearOption_Data\Managed\UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(NUCLEAR_OPTION_DIR)\NuclearOption_Data\Managed\UnityEngine.UIModule.dll" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="src\Assets\lifeboat" LogicalName="KropClientEffects.lifeboat" />
    <EmbeddedResource Include="src\Assets\Sounds\bulletcrack.wav" LogicalName="KropClientEffects.bulletcrack" />
    <EmbeddedResource Include="src\Assets\Sounds\SonicBooms\SonicBoom*.wav" LogicalName="KropClientEffects.SonicBooms.%(Filename)%(Extension)" />
    <EmbeddedResource Include="src\Assets\Textures\*.png" LogicalName="KropClientEffects.Textures.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
