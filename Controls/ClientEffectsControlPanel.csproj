<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework><LangVersion>latest</LangVersion><AssemblyName>ClientEffectsControlPanel</AssemblyName><Version>0.7.0</Version><Deterministic>true</Deterministic><NuGetAudit>false</NuGetAudit>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Nuclear Option</GameDir><Managed>$(GameDir)\NuclearOption_Data\Managed</Managed>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Shared/AdditionalEffectControls.cs" Link="Shared/AdditionalEffectControls.cs" />
    <Reference Include="BepInEx" HintPath="$(GameDir)\BepInEx\core\BepInEx.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(Managed)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(Managed)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(Managed)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(Managed)\UnityEngine.InputLegacyModule.dll" Private="false" />
  </ItemGroup>
</Project>
