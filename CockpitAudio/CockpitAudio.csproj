<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework><LangVersion>latest</LangVersion>
    <AssemblyName>Boscali.CockpitAudio</AssemblyName><Version>0.6.0</Version>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Nuclear Option</GameDir>
    <Managed>$(GameDir)\NuclearOption_Data\Managed</Managed><NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\Upstream-Boscali\modules\Immersion\Assets\Voice\*.wav" LogicalName="BoscaliSummer.Immersion.Voice.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\Upstream-Boscali\Core\Fx\Sfx\harness-creak-*.wav;..\Upstream-Boscali\Core\Fx\Sfx\hit-ping-*.wav;..\Upstream-Boscali\Core\Fx\Sfx\hull-thud.wav;..\Upstream-Boscali\Core\Fx\Sfx\radar-new.wav;..\Upstream-Boscali\Core\Fx\Sfx\radar-sweep.wav;..\Upstream-Boscali\Core\Fx\Sfx\gear-lever.wav;..\Upstream-Boscali\Core\Fx\Sfx\canopy-close.wav" LogicalName="BoscaliSummer.Sfx.%(Filename)%(Extension)" />
    <Reference Include="BepInEx" HintPath="$(GameDir)\BepInEx\core\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(GameDir)\BepInEx\core\0Harmony.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(Managed)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="Mirage" HintPath="$(Managed)\Mirage.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(Managed)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(Managed)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.AudioModule" HintPath="$(Managed)\UnityEngine.AudioModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(Managed)\UnityEngine.PhysicsModule.dll" Private="false" />
  </ItemGroup>
</Project>
