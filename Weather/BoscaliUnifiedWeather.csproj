<?xml version='1.0' encoding='utf-8'?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CS0649</NoWarn>
    <AssemblyName>BoscaliUnifiedWeather</AssemblyName>
    <RootNamespace>BoscaliUnifiedWeather</RootNamespace>
    <Version>0.8.3</Version>
    <Deterministic>true</Deterministic>
    <NuGetAudit>false</NuGetAudit>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Nuclear Option</GameDir>
    <Managed>$(GameDir)\NuclearOption_Data\Managed</Managed>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="BepInEx" HintPath="$(GameDir)\BepInEx\core\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(GameDir)\BepInEx\core\0Harmony.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(Managed)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="Assembly-CSharp-firstpass" HintPath="$(Managed)\Assembly-CSharp-firstpass.dll" Private="false" />
    <Reference Include="Mirage" HintPath="$(Managed)\Mirage.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(Managed)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(Managed)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.AssetBundleModule" HintPath="$(Managed)\UnityEngine.AssetBundleModule.dll" Private="false" />
    <Reference Include="UnityEngine.ParticleSystemModule" HintPath="$(Managed)\UnityEngine.ParticleSystemModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(Managed)\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="UnityEngine.AudioModule" HintPath="$(Managed)\UnityEngine.AudioModule.dll" Private="false" />
    <Reference Include="UnityEngine.ImageConversionModule" HintPath="$(Managed)\UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(Managed)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(Managed)\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(Managed)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(Managed)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(Managed)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="Unity.RenderPipelines.Core.Runtime" HintPath="$(Managed)\Unity.RenderPipelines.Core.Runtime.dll" Private="false" />
    <Reference Include="Unity.RenderPipelines.Universal.Runtime" HintPath="$(Managed)\Unity.RenderPipelines.Universal.Runtime.dll" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Plugin.cs" />
    <Compile Include="UnifiedEffects/**/*.cs" />
    <EmbeddedResource Include="../Payloads/*.dll" LogicalName="UnifiedEffects.Modules.%(Filename)%(Extension)" />
    <Compile Include="WeatherNetDisabled.cs" />
    <Compile Include="ThunderImmediate.cs" />
    <Compile Include="Weather/**/*.cs" Exclude="Weather/Assets/**;Weather/WeatherModule.cs;Weather/Patches/**;Weather/Presentation/WeatherMfdPanel.cs;Weather/Runtime/WeatherAutomation.cs;Weather/Runtime/CloudMotionProbe.cs;Weather/Networking/WeatherNet.cs;Weather/Audio/ThunderSoundscape.cs;Weather/Visuals/WeatherVolumeDressing.cs;Weather/Visuals/WeatherCloudPass.cs;Weather/Visuals/WeatherCloudShadows.cs;Weather/Visuals/CloudProbePass.cs;Weather/Visuals/CloudVolumeUniforms.cs;Weather/Visuals/CloudMaps.cs;Weather/Visuals/CloudBodies.cs;Weather/Visuals/CloudLowRes.cs;Weather/Visuals/CloudNoise3D.cs" />
    <Compile Include="Core/Contracts/**/*.cs" Exclude="Core/Contracts/IChatter.cs;Core/Contracts/IOpsPerks.cs" />
    <Compile Include="Core/Fx/**/*.cs" />
    <Compile Include="Core/Game/**/*.cs" Exclude="Core/Game/BoscaliMission.cs" />
    <Compile Include="Core/Lifecycle/**/*.cs" />
    <Compile Include="Core/Math/**/*.cs" />
    <Compile Include="Core/Net/**/*.cs" />
    <Compile Include="Core/Services/**/*.cs" />
    <Compile Include="Core/Ui/**/*.cs" Exclude="Core/Ui/MissionPrompt.cs" />
    <Compile Include="Core/Util/**/*.cs" />
    <Compile Include="AvionicsUi/**/*.cs" Exclude="AvionicsUi/**/Editor/**" />
    <EmbeddedResource Include="Weather/Assets/weatherrain.bundle" LogicalName="BoscaliSummer.Weather.weatherrain.bundle" />
    <EmbeddedResource Include="Core/Fx/Assets/particles.bundle" LogicalName="BoscaliSummer.Fx.particles.bundle" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="ClientEffects.doorman.json" LogicalName="doorman.json" />
    <EmbeddedResource Include="AvionicsUi/avionics.fui.avss" LogicalName="NOAvionics.avionics.fui.avss" />
    <EmbeddedResource Include="AvionicsUi/avionics.portal.avss" LogicalName="NOAvionics.avionics.portal.avss" />
    <EmbeddedResource Include="AvionicsUi/avionics.steel.avss" LogicalName="NOAvionics.avionics.steel.avss" />
    <EmbeddedResource Include="AvionicsUi/avionics.ace.avss" LogicalName="NOAvionics.avionics.ace.avss" />
    <EmbeddedResource Include="AvionicsUi/avionics.phosphor.avss" LogicalName="NOAvionics.avionics.phosphor.avss" />
    <EmbeddedResource Include="AvionicsUi/avionics.fieldops.avss" LogicalName="NOAvionics.avionics.fieldops.avss" />
    <EmbeddedResource Include="AvionicsUi/avionics.amber.avss" LogicalName="NOAvionics.avionics.amber.avss" />
    <EmbeddedResource Include="AvionicsUi/avionics.glass.avss" LogicalName="NOAvionics.avionics.glass.avss" />
    <EmbeddedResource Include="AvionicsUi/avionics.nightops.avss" LogicalName="NOAvionics.avionics.nightops.avss" />
    <EmbeddedResource Include="AvionicsUi/Assets/avionics-ui.bundle" LogicalName="NOAvionics.avionics-ui.bundle" />
    <EmbeddedResource Include="AvionicsUi/Assets/avionics-fx.bundle" LogicalName="NOAvionics.avionics-fx.bundle" />
    <EmbeddedResource Include="AvionicsUi/Assets/avionics-icons.bundle" LogicalName="NOAvionics.avionics-icons.bundle" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Rewired_Core" HintPath="$(Managed)/Rewired_Core.dll" Private="false" />
    <Reference Include="Newtonsoft.Json" HintPath="$(Managed)/Newtonsoft.Json.dll" Private="false" />
    <Reference Include="Mirage.SocketLayer" HintPath="$(Managed)/Mirage.SocketLayer.dll" Private="false" />
    <Reference Include="UniTask" HintPath="$(Managed)/UniTask.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(Managed)/UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="UnityEngine.AnimationModule" HintPath="$(Managed)/UnityEngine.AnimationModule.dll" Private="false" />
    <Reference Include="UnityEngine.JSONSerializeModule" HintPath="$(Managed)/UnityEngine.JSONSerializeModule.dll" Private="false" />
    <Reference Include="UnityEngine.VideoModule" HintPath="$(Managed)/UnityEngine.VideoModule.dll" Private="false" />
    <Reference Include="UnityEngine.UnityWebRequestModule" HintPath="$(Managed)/UnityEngine.UnityWebRequestModule.dll" Private="false" />
    <Reference Include="UnityEngine.UnityWebRequestAudioModule" HintPath="$(Managed)/UnityEngine.UnityWebRequestAudioModule.dll" Private="false" />
  </ItemGroup>
</Project>
